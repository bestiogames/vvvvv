    u_xlat10.z = u_xlat9.z;
    u_xlat5 = u_xlat11 * u_xlat2.zzzz + u_xlat5;
    u_xlat6 = u_xlat12 * u_xlat2.zzzz + u_xlat6;
    u_xlat4 = u_xlat10 * u_xlat2.zzzz + u_xlat4;
